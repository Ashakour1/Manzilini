generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id
  email            String     @unique
  name             String
  image            String?
  role             Role       @default(USER)
  status           UserStatus @default(ACTIVE)
  password         String
  is_sent_email    Boolean    @default(false)
  is_sent_at       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  // property_applications PropertyApplication[]
  properties       Property[]
  createdLandlords Landlord[]

  // link to agent profile
  agentId String?
  agent   FieldAgent? @relation(fields: [agentId], references: [id])

  // link to expenses
  expenses Expense[]
  incomes  Income[]

  // link to tenants created by this user
  tenants Tenant[]

  // task management
  assignedTasks Task[]         @relation("TaskAssignedTo")
  createdTasks  Task[]         @relation("TaskAssignedBy")
  notifications Notification[]
}

model Landlord {
  id              String             @id
  name            String
  email           String             @unique
  phone           String?
  company_name    String?
  address         String?
  remarks         String?
  nationality     String?
  isVerified      Boolean            @default(false)
  status          LandlordStatus     @default(ACTIVE)
  rejectionReason String?
  inactiveReason  String?
  is_sent_email   Boolean            @default(false)
  is_sent_at      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  properties      Property[]
  emailLogs       EmailLog[]
  documents       LandlordDocument[]

  // link to expenses
  expenses Expense[]
  incomes  Income[]

  // link to property applications
  propertyApplications PropertyApplication[]
  // creator
  createdBy            String?
  creator              User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  // tenants created by this landlord
  tenants              Tenant[]
}

model LandlordDocument {
  id         String   @id @default(cuid())
  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  documentType String?

  documentImage String?
  url           String?
  notes         String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AgentDocument {
  id      String     @id @default(cuid())
  agentId String
  agent   FieldAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  documentType String?

  documentImage String?
  notes         String?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Property {
  id                String           @id
  title             String
  description       String
  property_type     propertyType     @default(APARTMENT)
  status            Status           @default(FOR_RENT)
  price             Float
  currency          Currency         @default(KES)
  payment_frequency PaymentFrequency @default(MONTHLY)
  deposit_amount    Float?
  deposit_type      DepositType      @default(FIXED)
  country           String
  city              String
  address           String
  zip_code          String
  latitude          Float
  longitude         Float
  bedrooms          Int?
  bathrooms         Int?
  garages           Int?
  size              Float?
  is_furnished      Boolean?         @default(false)
  floor             Int?
  total_floors      Int?
  balcony           Boolean?         @default(false)
  amenities         String[]
  is_featured       Boolean?         @default(false)

  landlord_id           String?
  landlord              Landlord?             @relation(fields: [landlord_id], references: [id], onDelete: Restrict)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  property_applications PropertyApplication[]
  images                PropertyImages[]
  payments              Payment[]

  // link to expenses
  expenses     Expense[]
  incomes      Income[]
  is_published Boolean?  @default(false)

  // creator 
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PropertyImages {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Tenant {
  id String @id

  fullName String
  email    String? @unique
  phone    String  @unique

  status TenantStatus @default(NEW)

  lastActivityAt    DateTime?
  applicationsCount Int       @default(0)

  // Track which landlord created this tenant
  landlordId String?
  landlord   Landlord? @relation(fields: [landlordId], references: [id], onDelete: SetNull)

  // Track which user created this tenant
  createdBy     String?
  createdByUser User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications PropertyApplication[]
  activities   TenantActivity[]
}

model PropertyApplication {
  id String @id @default(uuid())

  // Tenant snapshot (guest or registered)
  fullName String
  email    String?
  phone    String
  message  String?

  // Relations
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  landlordId String
  landlord   Landlord @relation(fields: [landlordId], references: [id])

  // Application lifecycle
  status     ApplicationStatus @default(PENDING)
  isApproved Boolean           @default(false)
  remarks    String?

  statusChangedAt DateTime?
  statusChangedBy String?

  // Admin approval tracking (separate from workflow status)
  adminApprovalStatus AdminApprovalStatus @default(PENDING)
  adminApprovedAt     DateTime?
  adminApprovedBy     String?

  // Communication tracking
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  isCommunicated Boolean   @default(false)
  communicatedAt DateTime?

  viewingRequested Boolean   @default(false)
  viewingDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities TenantActivity[]
}

model TenantActivity {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  applicationId String?
  application   PropertyApplication? @relation(fields: [applicationId], references: [id])

  type        TenantActivityType
  description String?

  createdAt DateTime @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  applicationId String
  propertyId    String
  amount        Float
  status        PaymentStatus @default(PENDING)

  paymentDate DateTime? @default(now())
  createdAt   DateTime  @default(now())
  // application PropertyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model FieldAgent {
  id             String   @id
  name           String
  email          String   @unique
  phone          String?
  image          String?
  document_image String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // reverse relation: User can link to this agent
  users     User[]
  documents AgentDocument[]
}

model Employee {
  id         String         @id
  companyId  String?        @unique @map("company_id")
  name       String
  email      String         @unique
  phone      String?
  position   String?
  department String?
  status     EmployeeStatus @default(ACTIVE)
  hiredAt    DateTime?      @map("hired_at")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([name])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("employees")
}

model IdCounter {
  key       String   @id
  tableName String
  yearMonth String
  value     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableName, yearMonth])
  @@map("id_counters")
}

model EmailLog {
  id             String      @id @default(cuid())
  recipientEmail String
  recipientName  String?
  subject        String
  message        String      @db.Text
  emailType      EmailType
  status         EmailStatus @default(SENT)
  errorMessage   String?     @db.Text
  landlordId     String?
  landlord       Landlord?   @relation(fields: [landlordId], references: [id], onDelete: SetNull)
  metadata       String?     @db.Text // JSON string for additional data
  resendId       String? // Resend API message ID
  createdAt      DateTime    @default(now())

  @@index([recipientEmail])
  @@index([emailType])
  @@index([status])
  @@index([landlordId])
  @@index([createdAt])
  @@map("email_logs")
}

model Account {
  id      String  @id
  name    String
  balance Decimal @db.Decimal(15, 2)

  incomes  Income[]
  expenses Expense[]
}

model Income {
  id     String   @id
  date   DateTime
  source String // Rent, Commission, Service Fee, Other

  amount Decimal @db.Decimal(15, 2)

  paymentMethod String // Cash, Bank, Mobile Money

  // Link to account (uses Account.id which is String)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  // tenantId      BigInt?
  // tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  landlordId String?
  landlord   Landlord? @relation(fields: [landlordId], references: [id])

  reference   String?
  description String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([accountId])
}

model Expense {
  id String @id

  date     DateTime
  category String // Maintenance, Marketing, Utilities, Salary, Office

  amount Decimal @db.Decimal(15, 2)

  paymentMethod String // Cash, Bank, Mobile Money

  // Link to account (uses Account.id which is String)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  vendorName String?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  landlordId String?
  landlord   Landlord? @relation(fields: [landlordId], references: [id])

  reference   String?
  description String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  assignedToId String @map("assigned_to")
  assignedTo   User   @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)

  assignedById String @map("assigned_by")
  assignedBy   User   @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  priority   TaskPriority
  status     TaskStatus   @default(PENDING)
  dueDate    DateTime?    @map("due_date")
  reminderAt DateTime?    @map("reminder_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
  @@index([createdAt])
  @@map("tasks")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(TASK)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum DocumentType {
  ID
  PASSPORT
  LICENSE
  CERTIFICATE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
}

enum IncomeSource {
  RENT
  COMMISSION
  SERVICE_FEE
  OTHER
}

enum ExpenseCategory {
  MAINTENANCE
  MARKETING
  UTILITIES
  SALARY
  OFFICE
  OTHER
}

enum LandlordStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ApplicationStatus {
  PENDING // application submitted, not reviewed yet
  CONTACTED // landlord/agent contacted tenant
  APPROVED // accepted for this property
  REJECTED // not accepted
  CLOSED // finished (approved or rejected, no more action)
}

enum AdminApprovalStatus {
  PENDING // waiting for admin approval
  APPROVED // admin approved - visible to landlord
  REJECTED // admin rejected - not visible to landlord
}

enum TenantStatus {
  NEW
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TenantActivityType {
  APPLICATION_SENT
  CONTACTED
  APPROVED
  REJECTED
  VIEWING_REQUESTED
  STATUS_CHANGED
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  PROPERTY_OWNER
  AGENT
  LANDLORD
}

enum propertyType {
  APARTMENT
  HOUSE
  STUDIO
  OFFICE
  LAND
}

enum Status {
  FOR_SALE
  FOR_RENT
  SOLD
  RENTED
}

enum Currency {
  USD
  EUR
  KES
  GBP
  CAD
  AUD
  NZD
  CHF
  JPY
  CNY
}

enum PaymentFrequency {
  MONTHLY
  YEARLY
  WEEKLY
  DAILY
  FLEXIBLE
}

enum DepositType {
  FIXED
  PERCENTAGE
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
  TELEGRAM
  SMS
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TASK
  SYSTEM
  ALERT
}

enum EmailType {
  WELCOME
  PASSWORD_RESET
  VERIFICATION
  LANDLORD_APPROVAL
  LANDLORD_REJECTION
  LANDLORD_INACTIVE
  LANDLORD_ACTIVATION
  TENANT_REQUEST
  NOTIFICATION
  USER_CREDENTIALS
  USER_ACTIVATION
  USER_DEACTIVATION
}

enum EmailStatus {
  SENT
  FAILED
  PENDING
}
